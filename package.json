{
  "name": "claude-client",
  "version": "1.0.0",
  "private": true,
  "description": "여러 계정의 Claude 세션과 Gmail 인증을 분리하는 한국어 CLI 및 TUI",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./api": "./src/claude/api.js",
    "./runtime": "./src/runtime/create-runtime.js",
    "./auth": "./src/auth/magic-link.js",
    "./gmail": "./src/gmail/index.js"
  },
  "scripts": {
    "start": "node index.js",
    "profile": "node index.js profile",
    "bootstrap": "node index.js bootstrap",
    "cookies": "node index.js cookies",
    "logout": "node index.js logout",
    "browser-debug": "node index.js browser-debug",
    "chat-new": "node index.js chat-new",
    "chat-send": "node index.js chat-send",
    "chat-get": "node index.js chat-get",
    "chat-title": "node index.js chat-title",
    "prompt": "node scripts/prompt.js",
    "chat-prompt": "node prompt-chat.js",
    "chat-prompt2": "node prompt-chat2.js",
    "chat:cli": "node chat-cli.js",
    "chat:tui": "node chat-tui.js",
    "accounts": "node index.js account-list",
    "gmail:auth": "node index.js gmail-auth",
    "test": "node --test",
    "check": "npm run check:format && npm run check:syntax && npm run check:jsdoc && npm test",
    "check:syntax": "node scripts/check-syntax.js",
    "check:jsdoc": "node scripts/check-jsdoc.js",
    "login:bg": "node scripts/background-login.js",
    "login:it": "node scripts/interactive-login.js",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\" \"test/**/*.js\" \"test-support/**/*.js\" \"*.js\" \"README.md\" \"docs/**/*.md\" \"package.json\" \".prettierrc.json\"",
    "check:format": "prettier --check \"src/**/*.js\" \"scripts/**/*.js\" \"test/**/*.js\" \"test-support/**/*.js\" \"*.js\" \"README.md\" \"docs/**/*.md\" \"package.json\" \".prettierrc.json\""
  },
  "dependencies": {
    "axios": "^1.7.9",
    "axios-cookiejar-support": "^5.0.5",
    "chalk": "^5.6.2",
    "cycletls": "^2.0.5",
    "googleapis": "^171.4.0",
    "puppeteer-real-browser": "^1.4.4",
    "tough-cookie": "^4.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "prettier": "3.9.9"
  }
}
