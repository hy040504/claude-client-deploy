# Claude 웹 기본 주소입니다. 보통 https://claude.ai 그대로 둡니다.
BASE_URL=https://claude.ai

# 여러 계정의 인증 정보를 저장할 파일과 Claude 세션 디렉터리입니다.
ACCOUNTS_PATH=.data/accounts.json
ACCOUNTS_DATA_PATH=.data/accounts

# 실행할 계정을 고정합니다. 비우면 account-use로 선택한 계정을 사용합니다.
# 우선순위: --account > CLAUDE_ACCOUNT > account-use > default
CLAUDE_ACCOUNT=

# Claude UI/API에 보낼 언어 설정입니다.
LOCALE=ko-KR

# Claude 조직 ID입니다. 비워두면 쿠키/account_profile에서 자동 감지합니다.
ORG_ID=

# 채팅 명령에서 모델을 따로 지정하지 않았을 때 사용할 기본 모델입니다.
DEFAULT_MODEL=claude-sonnet-4-6

# 시간 표시와 로그인 utc_offset 계산에 사용할 타임존입니다.
TIMEZONE=Asia/Seoul

# Node HTTP 클라이언트 종류입니다. cycletls 또는 axios를 사용합니다.
HTTP_CLIENT=cycletls

# Node HTTP 요청 제한 시간입니다. 단위는 밀리초입니다.
REQUEST_TIMEOUT_MS=30000

# 아래 개별 상태 경로는 default 계정에만 적용됩니다. 새 계정은 ACCOUNTS_DATA_PATH 아래로 분리됩니다.
# 쿠키 jar 저장 경로입니다. 실제 세션 쿠키가 들어가므로 커밋하지 않습니다.
COOKIE_JAR_PATH=session-cookie-jar.json

# 브라우저/클라이언트 상태 저장 경로입니다. device id, session id, 캡처 헤더가 저장됩니다.
CLIENT_STATE_PATH=client-state.json

# 최근 채팅 이어가기 캐시 저장 경로입니다.
LAST_CHAT_PATH=last-chat.json

# 최근 Claude 인증 메일에서 추출한 코드 저장 경로입니다.
LATEST_CLAUDE_CODE_PATH=tmp/latest-claude-code.json

# Claude/Cloudflare 상태를 유지할 Chrome 프로필 경로입니다.
BROWSER_PROFILE_PATH=.browser-profile

# Chrome 실행 파일 경로입니다. 비워두면 OS별 기본 경로를 사용합니다.
CHROME_EXECUTABLE_PATH=

# 브라우저 플랫폼 힌트입니다. Windows, macOS, Linux 중 하나를 넣거나 비워두면 자동 감지합니다.
BROWSER_PLATFORM=

# sec-ch-ua-platform-version 값입니다. 비워두면 OS별 기본값을 사용합니다.
SEC_CH_UA_PLATFORM_VERSION=

# User-Agent 강제 지정값입니다. 비워두면 OS별 기본 User-Agent를 사용합니다.
USER_AGENT=

# Accept-Language 헤더 강제 지정값입니다. 비워두면 기본 헤더를 사용합니다.
ACCEPT_LANGUAGE=

# Node HTTP 경로에서 사용할 Accept-Encoding 헤더입니다.
ACCEPT_ENCODING=gzip, deflate, br, zstd

# Claude 웹 클라이언트 메타데이터입니다. 캡처한 최신 값이 없다면 기본값을 유지합니다.
ANTHROPIC_CLIENT_SHA=1287d6df5058e3b9ed2ef2518a2cb10f8f6068af
ANTHROPIC_CLIENT_PLATFORM=web_claude_ai
ANTHROPIC_CLIENT_VERSION=1.0.0

# 최종 브라우저 로그인 시도에서 로그인 쿠키를 기다릴 전체 제한 시간입니다. 단위는 밀리초입니다.
BROWSER_LOGIN_TIMEOUT_MS=300000

# 로그인 브라우저 모드입니다. background면 먼저 숨김/백그라운드 시도 후 필요 시 interactive로 재시도합니다.
BROWSER_LOGIN_MODE=background

# background 로그인 첫 시도 제한 시간입니다. 초과하면 interactive Chrome으로 재시도합니다.
BROWSER_LOGIN_BACKGROUND_TIMEOUT_MS=60000

# API fallback에 사용할 브라우저 모드입니다. background 또는 interactive를 사용합니다.
BROWSER_FALLBACK_MODE=background

# browser-debug 명령의 기본 브라우저 모드입니다.
BROWSER_DEBUG_MODE=interactive

# interactive 모드의 Puppeteer headless 설정입니다. false, true 또는 Chrome headless 모드 문자열을 넣습니다.
BROWSER_INTERACTIVE_HEADLESS=false

# background 모드의 Puppeteer headless 설정입니다.
BROWSER_BACKGROUND_HEADLESS=false

# background 모드에만 추가할 Chrome 인자입니다. 공백으로 구분합니다.
BROWSER_BACKGROUND_ARGS=

# Chrome에 --no-sandbox를 추가할지 여부입니다. Linux 서버는 보통 true, Windows 데스크톱은 보통 false입니다.
BROWSER_NO_SANDBOX=false

# puppeteer-real-browser의 Xvfb 처리를 끌지 여부입니다. 가상 디스플레이가 필요한 서버에서는 보통 false입니다.
BROWSER_DISABLE_XVFB=false

# 모든 Chrome 모드에 추가할 인자입니다. 공백으로 구분합니다.
BROWSER_EXTRA_ARGS=

# Chrome fallback 전에 CycleTLS 로그인 시도를 할지 여부입니다.
CLAUDE_CYCLETLS_LOGIN=true

# Chrome fallback에서 challenge 통과 후 같은 브라우저 세션으로 로그인 메일 요청을 보낼지 여부입니다.
CLAUDE_BROWSER_MAGIC_LINK_REQUEST=true

# 브라우저 세션 내부 magic-link 요청 제한 시간입니다. 단위는 밀리초입니다.
CLAUDE_BROWSER_MAGIC_LINK_REQUEST_TIMEOUT_MS=60000

# Claude 로그인 이메일입니다. 비워두면 GMAIL_USER_EMAIL을 재사용합니다.
CLAUDE_LOGIN_EMAIL=

# Claude 웹에서 관측된 Arkose public key입니다. solver 설정이 아니라 메타데이터입니다.
ARKOSE_PUBLIC_KEY=EEA5F558-D6AC-4C03-B678-AABF639EE69A

# Arkose site/origin 값입니다.
ARKOSE_SITE=https://claude.ai

# Arkose CDN 기본 주소입니다.
ARKOSE_BASE_URL=https://a-cdn.claude.ai

# 브라우저 패킷에서 관측된 Arkose build id입니다.
ARKOSE_BUILD_ID=7ecbd953-09aa-4047-9b10-febe0ed32f28

# 이미 확보한 Arkose token이 있을 때만 넣습니다. 없으면 비워둡니다.
ARKOSE_SESSION_TOKEN=

# CycleTLS에서 HTTP/1.1을 강제할지 여부입니다. 보통 false입니다.
CYCLETLS_FORCE_HTTP1=false

# CycleTLS에서 HTTP/3을 강제할지 여부입니다. 보통 false입니다.
CYCLETLS_FORCE_HTTP3=false

# JA3 TLS fingerprint를 직접 지정할 때 사용합니다. 보통 비워둡니다.
CYCLETLS_JA3=

# JA4R TLS fingerprint를 직접 지정할 때 사용합니다. 보통 비워둡니다.
CYCLETLS_JA4R=

# CycleTLS HTTP/2 fingerprint 문자열입니다.
CYCLETLS_HTTP2_FINGERPRINT=1:65536;2:0;4:6291456;6:262144|15663105|0|m,a,s,p

# 신규 계정의 기본 인증 방식입니다. 계정 추가 시 direct 또는 relay를 지정할 수 있습니다.
GMAIL_AUTH_MODE=direct

# relay 모드에서 사용할 원격 서버 주소입니다. 원격은 HTTPS, 로컬 테스트는 HTTP를 사용합니다.
GMAIL_RELAY_SERVER_URL=

# relay 서버가 요구하는 공통 API key입니다. 필요하지 않으면 비워둡니다.
GMAIL_RELAY_API_KEY=

# default 계정의 기존 relay token을 읽는 호환 설정입니다. 새 인증은 계정 저장소에 저장합니다.
GMAIL_RELAY_SESSION_TOKEN=

# relay OAuth 완료 여부를 확인하는 주기입니다. 단위는 밀리초입니다.
GMAIL_RELAY_POLL_MS=2500

# OAuth 인증 대기 제한 시간입니다. 단위는 밀리초입니다.
GMAIL_AUTH_TIMEOUT_MS=300000

# 직접 연결 시 여러 계정이 공통으로 사용할 Gmail OAuth client id입니다.
GMAIL_CLIENT_ID=

# Gmail read-only API용 Google OAuth client secret입니다.
GMAIL_CLIENT_SECRET=

# default 계정에만 적용하는 기존 refresh token입니다. 새 인증은 .env를 수정하지 않습니다.
GMAIL_REFRESH_TOKEN=

# Claude 로그인 메일을 받는 Gmail 주소입니다.
GMAIL_USER_EMAIL=

# Claude/Anthropic 로그인 메일을 찾을 Gmail 검색 쿼리입니다.
GMAIL_CLAUDE_QUERY=newer_than:30d

# 검색할 Gmail 메일 최대 개수입니다.
GMAIL_CLAUDE_MAX_RESULTS=20

# 로그인 메일을 기다릴 때 Gmail을 다시 확인하는 주기입니다. 단위는 밀리초입니다.
GMAIL_POLL_MS=10000

# Gmail에서 찾은 인증 링크를 자동으로 열지 여부입니다.
GMAIL_OPEN_VERIFICATION_LINK=true

# Gmail 인증 링크를 Chrome보다 먼저 CycleTLS로 열어볼지 여부입니다.
GMAIL_TRY_CYCLETLS_VERIFICATION_LINK=true

# 숫자 인증코드를 Chrome 입력칸에 자동 입력할지 여부입니다.
GMAIL_AUTO_FILL_VERIFICATION_CODE=true

# 인증 링크를 여는 제한 시간입니다. 단위는 밀리초입니다.
GMAIL_VERIFICATION_LINK_TIMEOUT_MS=60000

# Google OAuth redirect URI에 표시할 호스트입니다.
GMAIL_AUTH_HOST=127.0.0.1

# OAuth callback 서버가 바인딩할 로컬 호스트입니다.
GMAIL_AUTH_BIND_HOST=127.0.0.1

# OAuth callback 서버 포트입니다.
GMAIL_AUTH_PORT=3000

# OAuth callback 경로입니다.
GMAIL_AUTH_PATH=/oauth2callback

# 기존 브라우저에서 복사한 Cookie 헤더를 넣으면 실행 시 cookie jar에 주입합니다.
CAPTURED_COOKIE=

# 캡처한 브라우저 요청 헤더입니다. JSON 객체 또는 줄바꿈으로 구분된 Header: value 형식을 지원합니다.
CAPTURED_HEADERS=

# Windows에서 background 창을 화면 밖으로 보내고 싶을 때의 예시입니다.
# BROWSER_BACKGROUND_ARGS=--window-position=-32000,-32000

# Ubuntu 서버 예시입니다.
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
# BROWSER_NO_SANDBOX=true
# BROWSER_DISABLE_XVFB=false
